            background-color: var(--tg-theme-bg-color);
            color: var(--tg-theme-text-color);
            margin: 0;
            padding: 16px;
            box-sizing: border-box;
        }
        h1 {
            font-size: 24px;
            margin: 0 0 20px 0;
            text-align: center;
        }

        .form-group {
            margin-bottom: 16px;
        }
        label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 6px;
        }
        .input-container {
            display: flex;
            gap: 8px;
        }
        input, select, textarea {
            flex: 1;
            padding: 10px;
            border: 1px solid var(--tg-theme-hint-color);
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 16px;
            background-color: var(--tg-theme-bg-color);
            color: var(--tg-theme-text-color);
        }
        textarea {
            width: 100%;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--tg-theme-button-color);
        }
        .btn-action {
            background-color: var(--tg-theme-secondary-bg-color);
            color: var(--tg-theme-button-color);
            border: 1px solid var(--tg-theme-button-color);
            border-radius: 8px;
            padding: 0 12px;
            font-weight: bold;
            cursor: pointer;
            white-space: nowrap;
        }
        .button-group {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }
        .btn-main {
            flex: 1;
            padding: 12px;
            font-size: 16px;
            font-weight: bold;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }
        .btn-submit {
