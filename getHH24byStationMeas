    <script>
        // Inicializácia a prepojenie s Telegram klientom
        const tg = window.Telegram.WebApp;
        
        // Informuje Telegram, že Mini App je plne načítaná a pripravená
        tg.ready(); 
        tg.expand(); // Roztiahne okno na celú výšku displeja

        function getLocalDateTimeString() {
            const now = new Date();
            const tzOffset = now.getTimezoneOffset() * 60000;
            return (new Date(now - tzOffset)).toISOString().slice(0, 16);
        }

        function formatToSlovakDateTime(isoString) {
            if (!isoString) return "";
            const [datePart, timePart] = isoString.split('T');
            const [year, month, day] = datePart.split('-');
            return `${day}.${month}.${year} ${timePart}`;
        }

        window.addEventListener('DOMContentLoaded', () => {
            document.getElementById('dateTimeAt').value = getLocalDateTimeString();
        });

        document.querySelectorAll('.btn-now').forEach(button => {
            button.addEventListener('click', (e) => {
                const targetId = e.target.getAttribute('data-target');
                document.getElementById(targetId).value = getLocalDateTimeString();
            });
        });

        function getDistance(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon/2) * Math.sin(dLon/2);
            return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)));
        }

document.getElementById('btnLocation').addEventListener('click', () => {
    const status = document.getElementById('locationStatus');

    if (!navigator.geolocation) {
        status.innerText = "GPS nie je podporované v tomto prehliadači.";
        return;
    }

    status.innerText = "Hľadám polohu...";

    navigator.geolocation.getCurrentPosition(
        (pos) => {
            const uLat = pos.coords.latitude;
            const uLon = pos.coords.longitude;

            const select = document.getElementById('station');
            let closest = "";
            let minD = Infinity;

            for (let i = 0; i < select.options.length; i++) {
                const opt = select.options[i];
                if (opt.value === "") continue;

                const lat = parseFloat(opt.getAttribute('data-lat'));
                const lon = parseFloat(opt.getAttribute('data-lon'));

                const d = getDistance(uLat, uLon, lat, lon);

                if (d < minD) {
                    minD = d;
                    closest = opt.value;
                }
            }

            if (closest) {
                select.value = closest;
                status.innerText = `Nastavené podľa GPS, vzdialenosť ${minD.toFixed(1)} km.`;
            }
        },
        (err) => {
            let msg = "Chyba GPS.";

            if (err.code === 1) msg = "Poloha bola zamietnutá. Povoľ polohu pre Telegram.";
            if (err.code === 2) msg = "Poloha nie je dostupná. Skús zapnúť GPS.";
            if (err.code === 3) msg = "Vypršal čas hľadania polohy. Skús znova.";

            status.innerText = `${msg} Kód chyby: ${err.code}`;
        },
        {
            enableHighAccuracy: true,
            timeout: 15000,
            maximumAge: 0
        }
    );
});

        document.getElementById('btnCancel').addEventListener('click', () => { 
            tg.close(); // Natívne zatvorenie okna v aplikácii Telegram
        });

        document.getElementById('appForm').addEventListener('submit', (e) => {
            e.preventDefault();
            
            const formattedAt = formatToSlovakDateTime(document.getElementById('dateTimeAt').value);

            const formData = {
                action: "GetHourlyData",
                station: document.getElementById('station').value,
                substance: document.getElementById('substance').value,
                dtAt: formattedAt
            };

            // Oficiálne odoslanie textového reťazca do getUpdates bota
            tg.sendData(JSON.stringify(formData));
            
            // Po odoslaní Telegram automaticky aplikáciu zatvorí
            tg.close(); 
        });
    </script>
